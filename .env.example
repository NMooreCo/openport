# Copy to .env and fill in. .env is gitignored.

# Nebius Token Factory API key: https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Tavily API key: https://app.tavily.com
TAVILY_API_KEY=

# GitHub token with repo scope, used to open PRs.
# Leave empty to fall back to `gh auth token`.
GITHUB_TOKEN=

# Optional: pin the Nemotron model for each tier.
# Left empty, OpenPort picks them from Token Factory's /v1/models list.
# OPENPORT_MODEL_NANO=
# OPENPORT_MODEL_SUPER=
# OPENPORT_MODEL_ULTRA=

# Optional: only needed to record reference outputs from the original closed models.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
