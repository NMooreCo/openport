// The live dashboard: OpenPort's Docker image in a Cloudflare Container, behind a Worker on a custom domain.
// Needs the Workers Paid plan. The keys are Worker secrets (`npx wrangler secret put NEBIUS_API_KEY --config
// live/wrangler.jsonc`, and TAVILY_API_KEY), passed to the container when it starts; they're never in the image.
// JUDGE_PASSWORD, also a secret, keeps live runs for whoever has it; without it, anyone may start them.
// GITHUB_TOKEN, a secret too, is a fine-grained token for the SANDBOX_ORG organization: with it, a finished live
// port's pull request can be opened there. See deploy/cloudflare/README.md.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "openport-dashboard",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-27",
	"observability": { "enabled": true },
	"containers": [
		{
			"class_name": "Dashboard",
			// The Durable Object starts the container itself, choosing the image and instance size (src/index.ts).
			// One instance, billed only while awake: runs and their live event streams are held in its memory.
			"scheduling_policy": "durable_object",
			"images": {
				"dashboard": { "dockerfile": "../../../Dockerfile", "build_context": "../../.." }
			}
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "DASHBOARD", "class_name": "Dashboard" }]
	},
	"exports": {
		"Dashboard": { "type": "durable-object", "storage": "sqlite" }
	},
	// Also at openport-dashboard.<account subdomain>.workers.dev, which works whatever the custom domain's DNS does.
	"workers_dev": true,
	// Redirect rules run before Workers: the zone's own redirect to narralogy.ai has to skip this hostname.
	"routes": [{ "pattern": "nebius.narralogy.com", "custom_domain": true }],
	"vars": {
		// What live runs (the judges', with JUDGE_PASSWORD set) may spend on Token Factory per day. A SupportDesk run
		// costs about $0.70, preflight's about $0.07. The demos replay recorded runs for free.
		"OPENPORT_DAILY_BUDGET_USD": "5",
		// New runs started per UTC day, counted by the Worker so a sleeping container can't reset it. Replays of the
		// recorded demos don't count; past the cap, only they and runs the server already has are shown.
		"NEW_RUNS_PER_DAY": "30",
		// The GitHub organization pull requests are opened in (with GITHUB_TOKEN set), each in a fork of the repo
		// ported, so its maintainers aren't notified; and how many may be opened per UTC day.
		"SANDBOX_ORG": "narralogy-labs",
		"NEW_PRS_PER_DAY": "20",
		// The demo video, embedded on the front page once it's on YouTube.
		"VIDEO_URL": ""
	}
}
